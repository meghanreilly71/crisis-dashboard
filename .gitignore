# human reference-standard lineage: first_pass -> n114 -> revision1 -> postfix
!data/benchmark/snapshots/*.csv
# validity / agreement / diagnostic tables
!data/validity/*.csv
# sample ID manifests (metadata only: idx, corpus, outlet, year, date, source_row)
!data/benchmark/benchmark_ids.csv
!data/benchmark/benchmark_ids_climate_expansion.csv
# calibration results (token counts and costs, no text)
!data/annotated/final_codebook/token_usage.csv

!data/annotated/benchmark_stability/*.csv
data/annotated/benchmark_stability/DEPRECATED_*.csv

# Run logs and session tooling
